{
  "name": "ccui",
  "version": "0.0.1",
  "private": true,
  "description": "An open-source Catholic interface system for shared digital form, beauty, and usability across Catholic digital projects.",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @ccui/web dev",
    "build": "pnpm generate:stats && pnpm --filter @ccui/web build",
    "lint": "pnpm --filter @ccui/web lint",
    "typecheck": "pnpm --filter @ccui/web typecheck",
    "generate:stats": "node apps/web/scripts/generate-system-stats.mjs"
  },
  "keywords": [
    "catholic",
    "design-system",
    "ui-kit",
    "components",
    "tokens",
    "liturgical",
    "open-source"
  ]
}
