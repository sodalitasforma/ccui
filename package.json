{
  "name": "ccui",
  "version": "0.0.1",
  "private": true,
  "description": "An open-source Catholic interface system for shared digital form, beauty, and usability across Catholic digital projects.",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @ccui/web dev",
    "build": "pnpm generate:stats && pnpm --filter @ccui/web build",
    "lint": "pnpm --filter @ccui/web lint",
    "typecheck": "pnpm --filter @ccui/web typecheck",
    "generate:stats": "node apps/web/scripts/generate-system-stats.mjs",
    "check:css-contract": "node apps/web/scripts/audit-css-contracts.mjs",
    "check:docs-search": "node apps/web/scripts/audit-docs-search-anchors.mjs",
    "check:icons": "node apps/web/scripts/audit-icons.mjs",
    "check:theme-tokens": "node apps/web/scripts/audit-theme-tokens.mjs",
    "check": "pnpm check:icons && pnpm check:catholic && pnpm check:theme-tokens && pnpm check:docs-search && pnpm check:css-contract && pnpm lint && pnpm typecheck && pnpm build && pnpm audit",
    "check:catholic": "node apps/web/scripts/audit-catholic-package.mjs",
    "audit:mobile": "node apps/web/scripts/mobile-audit.mjs",
    "audit:mobile:serve": "pnpm --filter @ccui/web build && pnpm --filter @ccui/web start",
    "audit:mobile:summary": "node apps/web/scripts/mobile-audit-summary.mjs"
  },
  "keywords": [
    "catholic",
    "design-system",
    "ui-kit",
    "components",
    "tokens",
    "liturgical",
    "open-source"
  ],
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.10"
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.60.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
