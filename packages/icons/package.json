{
  "name": "@catholiccommons/icons",
  "version": "0.0.2",
  "description": "SVG icon components for Catholic Commons UI.",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "react": "19.2.4"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "sideEffects": [],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react --external react-dom --tsconfig ../../tsconfig.package.json && node ../../scripts/prepend-use-client.cjs"
  }
}
