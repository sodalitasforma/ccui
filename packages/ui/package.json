{
  "name": "@catholiccommons/ui",
  "version": "0.0.1",
  "description": "Umbrella package for Catholic Commons UI.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@catholiccommons/tokens": "workspace:*",
    "@catholiccommons/primitives": "workspace:*",
    "@catholiccommons/catholic": "workspace:*",
    "@catholiccommons/icons": "workspace:*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./src/styles.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "package.json"
  ]
}
