{
  "name": "@catholiccommons/ui",
  "version": "0.0.2",
  "description": "Umbrella package for Catholic Commons UI.",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@catholiccommons/tokens": "workspace:*",
    "@catholiccommons/primitives": "workspace:*",
    "@catholiccommons/catholic": "workspace:*",
    "@catholiccommons/icons": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/styles.css",
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react --external react-dom --tsconfig ../../tsconfig.package.json && cp src/styles.css dist/styles.css && node ../../scripts/prepend-use-client.cjs"
  }
}
