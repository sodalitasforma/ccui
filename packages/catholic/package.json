{
  "name": "@catholiccommons/catholic",
  "version": "0.0.2",
  "description": "Catholic-specific UI components for Catholic Commons UI.",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "react": "19.2.4"
  },
  "dependencies": {
    "@catholiccommons/primitives": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./catholic.css": "./dist/catholic.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/catholic.css",
    "./dist/styles/*.css",
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react --external react-dom --tsconfig ../../tsconfig.package.json && cp -R src/styles dist/styles && cp src/catholic.css dist/catholic.css && node ../../scripts/prepend-use-client.cjs"
  }
}
